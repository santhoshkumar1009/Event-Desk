{
  "name": "eventflow-server",
  "version": "1.0.0",
  "description": "EventFlow backend API",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
