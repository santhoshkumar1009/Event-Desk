# Server Port (Render automatically supplies PORT in production)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# PostgreSQL Connection String (Required for Render / Production / Neon / Supabase)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/eventflow

# JSON Web Token Secret Key for signing user authentication tokens
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Google Gemini Generative AI API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend URL(s) for CORS and Socket.IO (e.g. https://your-app.vercel.app)
# Supports comma-separated origins. Use * or leave empty to allow all origins.
FRONTEND_URL=http://localhost:5173
